# Athena Environment Variables
# Copy this file to .env and fill in the values

# PostgreSQL Configuration
POSTGRES_USER=athena
POSTGRES_PASSWORD=athena
POSTGRES_DB=athena

# Backend Configuration
DATABASE_URL=postgresql+asyncpg://athena:athena@localhost:8981/athena
REDIS_URL=redis://localhost:8982
CORS_ORIGINS=http://localhost:8979,http://tinxudev.airplane-manta.ts.net:8979

# Auth Configuration (MUST be identical in frontend and backend)
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Frontend Configuration
NEXTAUTH_URL=http://localhost:8979
NEXT_PUBLIC_API_URL=http://localhost:8980

# OAuth Configuration (optional — social login won't work without these)
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
AUTH_FACEBOOK_ID=your-facebook-app-id
AUTH_FACEBOOK_SECRET=your-facebook-app-secret

# External API Keys (optional for initial setup)
OPENROUTER_API_KEY=your-openrouter-api-key-for-embeddings
