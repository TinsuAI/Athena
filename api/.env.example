# Athena API Environment Variables
# Copy this file to .env and update with your actual values

# Application Settings
APP_NAME="Athena HS Code Lookup API"
ENVIRONMENT=development

# Database Configuration
# IMPORTANT: Use postgresql+asyncpg:// for async SQLAlchemy
# For Docker: use service name 'postgres' as host
# For local dev: use 'localhost'
DATABASE_URL=postgresql+asyncpg://athena_user:athena_password@postgres:5432/athena_db

# Redis Configuration
# For Docker: use service name 'redis' as host
# For local dev: use 'localhost'
REDIS_URL=redis://redis:6379/0

# Authentication
# CRITICAL: This secret must match NEXTAUTH_SECRET in frontend .env
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-min-32-chars-change-this-in-production

# OpenRouter API (for embeddings generation)
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# CORS Settings
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=INFO

# Security
# Session expiry in seconds (default: 24 hours)
SESSION_EXPIRE_SECONDS=86400

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
